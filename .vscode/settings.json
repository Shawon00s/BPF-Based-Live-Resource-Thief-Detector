{
  // ── Interpreter ───────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python3",
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // ── Performance ───────────────────────────────────────────────────────────
  // venv/ holds ~12,000 files (torch alone is >1 GB).  Watching, searching and
  // type-analysing all of it makes the first notebook cell appear to hang for
  // 30-60 s while VS Code indexes.  Excluding it does not affect imports —
  // the interpreter path above still resolves every package normally.
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.ipynb_checkpoints/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  },
  "python.analysis.exclude": [
    "**/venv/**",
    "**/__pycache__/**"
  ],
  // Index only what we import, instead of walking every dependency
  "python.analysis.indexing": true,
  "python.analysis.packageIndexDepths": [
    { "name": "torch",   "depth": 2 },
    { "name": "sklearn", "depth": 2 }
  ],
  // Skip re-activating the venv in every new terminal
  "python.terminal.activateEnvironment": false,

  // ── Notebooks ─────────────────────────────────────────────────────────────
  "notebook.kernelPicker.type": "mru",
  "notebook.output.textLineLimit": 60,
  "notebook.lineNumbers": "on",

  "files.associations": { "*.c": "c" }
}
